<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
    pageEncoding="ISO-8859-1"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<title>Cashier</title>
</head>
<style>
input[type=text], input[type=password] {
    width: 220px;
    padding: 12px 20px;
    margin: 6px 0;
    display:run-in;
    border: 2px solid #ccc;
    box-sizing:border-box;
}
button {
    background-color: #4CAF50;
    color: white;
    padding: 12px 20px;
    margin: 8px 0;
    border: none;
    cursor: pointer;
    width: 100px;
}
button:hover {
	background-color:none;
	color: white;
}
.container {
    padding: 6px;
  
    }
    #f1{
    border-color: blue;
    }
  
body{
background-image: url(".jpeg");
}
</style>
<body>
<div><img alt="logo" src="" style="width:250px;height:100px;">
</div>
<form action=""  >
<center><h1><b style="color:black">Search Customer</b></h1></center>
<div class="container" align="center">
    <label><b>Customer SSN ID (or) Customer ID</b></label>
    <input style="width:8cm;"type="text" placeholder="Enter Customer SSN ID/Customer ID" name="CustomerSSNID" >
    </div>
    <div align="center">
       <button type="submit" class="cancelbtn" name="action"  value="search" onclick="return validateForm();">Search</button>
       <button type="reset" class="reset" name="action" value="reset" >Reset</button>
    </div>

</form>
</body>
</html>