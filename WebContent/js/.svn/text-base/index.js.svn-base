function validateForm() {
	var uname = document.getElementById("uname").value;
	var pwsd = document.getElementById("pswd").value;
	if (uname == "" || uname == null) {
		alert("Please Enter UserName");
		return false;
	}
	if (uname.length!=8) {
		alert("username must be 8 characters");
		return false;
	}
	if (pwsd == "" || pwsd == null) {
		alert("Please Enter Password");
		return false;
	}
	if (pwsd.length!=10) {
		alert("Password must be 10 digits");
		return false;
	}
}