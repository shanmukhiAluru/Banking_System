<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
 
<hibernate-mapping>
<class name="bean.Account" table="Account_Group2">
<id name="accountId" column="accountId">
<!-- <generator class="foreign"> -->
<generator class="sequence">
<param name="sequence">AccountIdGenerator</param>
</generator>
</id>
<property name="custId" column="custId" type="int"></property>
<property name="accountType" column="accountType" type="string"></property>
<property name="depositAmount" column="depositAmount" type="int"></property>

<one-to-one name="accStatus" class="bean.AccountStatus"
			cascade="all" />

<!-- <many-to-one name="custId" column="custId" ></many-to-one> -->


</class>

</hibernate-mapping>