<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="bean.Customer" table="CustomerGroup2">
		<id name="custId" column="custId">
			<generator class="sequence">
				<param name="sequence">CustomerIdGenerator</param>
			</generator>
		</id>
		<property name="custName" column="custName" type="string"></property>
		<property name="ssnId" column="ssnId" type="int"></property>
		<property name="age" column="age" type="int"></property>
		<property name="add_line1" column="add_line1" type="string"></property>
		<property name="add_line2" column="add_line2" type="string"></property>
		<property name="city" column="city" type="string"></property>
		<property name="state" column="state" type="string"></property>
		<one-to-one name="custStatus" class="bean.CustomerStatus"
			cascade="all" />
		<set name="accList" cascade="all" lazy="false" fetch="join">
			<key column="custId"></key>
			<one-to-many class="bean.Account" />
		</set>

	</class>

</hibernate-mapping>
