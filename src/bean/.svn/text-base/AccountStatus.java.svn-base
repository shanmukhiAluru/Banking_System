package bean;

public class AccountStatus {
	
    // AccountStatus table columns – Customer ID, Account ID, Account Type, Status, Message, Last Updated
	private int custId;
	private int accountId;
	private String accountType;
	private String status;
	private String message;
	private String lastUpdate;
	public int getCustId() {
		return custId;
	}
	public void setCustId(int custId) {
		this.custId = custId;
	}
	public int getAccountId() {
		return accountId;
	}
	public void setAccountId(int accountId) {
		this.accountId = accountId;
	}
	public String getAccountType() {
		return accountType;
	}
	public void setAccountType(String accountType) {
		this.accountType = accountType;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getMessage() {
		return message;
	}
	public void setMessage(String message) {
		this.message = message;
	}
	public String getLastUpdate() {
		return lastUpdate;
	}
	public void setLastUpdate(String lastUpdate) {
		this.lastUpdate = lastUpdate;
	}
	public AccountStatus(int custId, int accountId, String accountType,
			String status, String message, String lastUpdate) {
		super();
		this.custId = custId;
		this.accountId = accountId;
		this.accountType = accountType;
		this.status = status;
		this.message = message;
		this.lastUpdate = lastUpdate;
	}
	public AccountStatus() {
		super();
	}
	
	

}
