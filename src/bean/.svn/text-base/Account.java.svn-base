package bean;

public class Account {
	 /*Customer ID
	 * Drop down – Savings or Current Account
	 * Deposit amount – Integer / Number (No decimals)
*/
	private int accountId;
	private int custId;
	private String accountType;
	private int depositAmount;
	private AccountStatus accStatus;
	
	
	
	public AccountStatus getAccStatus() {
		return accStatus;
	}
	public void setAccStatus(AccountStatus accStatus) {
		this.accStatus = accStatus;
	}
	public Account(int accountId, int custId, String accountType,
			int depositAmount) {
		super();
		this.accountId = accountId;
		this.custId = custId;
		this.accountType = accountType;
		this.depositAmount = depositAmount;
	}
	public Account() {
		super();
		// TODO Auto-generated constructor stub
	}
	public int getAccountId() {
		return accountId;
	}
	public void setAccountId(int accountId) {
		this.accountId = accountId;
	}
	public int getCustId() {
		return custId;
	}
	public void setCustId(int custId) {
		this.custId = custId;
	}
	public String getAccountType() {
		return accountType;
	}
	public void setAccountType(String accountType) {
		this.accountType = accountType;
	}
	public int getDepositAmount() {
		return depositAmount;
	}
	public void setDepositAmount(int depositAmount) {
		this.depositAmount = depositAmount;
	}

	
	
}
